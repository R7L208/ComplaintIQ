# CFPB Consumer Complaint Database download URL.
CFPB_COMPLAINTS_URL=https://files.consumerfinance.gov/ccdb/complaints.csv.zip

# Data directory and dataset file names, relative to the project root.
DATA_DIR=data
COMPLAINTS_ZIP=complaints.csv.zip
COMPLAINTS_CSV=complaints.csv

# Parquet outputs produced by the ETL. Override on the command line if needed.
COMPLAINTS_PARQUET=complaints.parquet
COMPLAINTS_NARRATIVE_ONLY_PARQUET=complaints_narrative_only.parquet

# Default C++ build directory. Override with BUILD_DIR=... on the command line.
BUILD_DIR=build

# Python virtual environment (uv) for notebook / ML work in Zed.
# VENV_DIR is where uv creates the venv; Zed auto-detects a ".venv" here.
# PYTHON_VERSION is the interpreter uv provisions (downloading it if missing).
VENV_DIR=.venv
PYTHON_VERSION=3.12

# Databricks (Free Edition): bundle and bi-directional Git folder sync.
# The per-developer CLI profile (~/.databrickscfg) and its workspace host are
# NOT set here because they are personal. Set DATABRICKS_PROFILE in the
# git-ignored local.mk (see local.mk.example); the profile supplies the host.
#
# Databricks Git folder (Repo) name is the bi-directional editing surface.
# git is the sync medium: edit here or locally and push/pull to stay in sync.
# The full path (/Users/<you>/<name>) is derived from the signed-in CLI user
# at run time, so no personal identity is committed to the repo.
DATABRICKS_GIT_FOLDER_NAME=ComplaintIQ

# The repo URL the Git folder clones is NOT hardcoded here: it is derived from
# your local 'origin' remote by the Makefile, so forks target their own repo.

# Unity Catalog location for the large datasets (must match databricks.yml).
UC_CATALOG=workspace
UC_SCHEMA=complaintiq
UC_VOLUME=data

# C++ executable and CMake target names.
ETL_BIN_NAME=complaintiq_etl
SCHEMA_VALIDATOR_BIN_NAME=complaintiq_validate_parquet_schema
VALUES_VALIDATOR_BIN_NAME=complaintiq_validate_parquet_values
